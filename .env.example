# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
# Every value here is server-side only. There is deliberately no
# NEXT_PUBLIC_APPWRITE_* variable: no Appwrite credential ever reaches the
# browser.

# Your Appwrite server's API endpoint. Self-hosted ends in /v1; Appwrite
# Cloud is https://cloud.appwrite.io/v1
APPWRITE_ENDPOINT=https://appwrite.example.com/v1

# Appwrite console → your project → Settings → Project ID
APPWRITE_PROJECT_ID=

# Appwrite console → Overview → Integrations → API keys → Create.
# Scopes needed: databases.*, collections.*, attributes.*, indexes.*,
# documents.*, users.read
APPWRITE_API_KEY=

# The database's ID, NOT its name. Create the database yourself in
# Databases → Create database; `npm run setup` creates the collections
# inside it but not the database itself.
APPWRITE_DATABASE_ID=

# --- Only needed to run `npm test` -----------------------------------------

# Where the contract test points. Leave as-is for local development.
TEST_BASE_URL=http://localhost:3000

# Filled in for you by `npx tsx scripts/seed-test-env.mjs` — leave empty.
TEST_API_KEY=

# An Appwrite user to log in as. Without these two, the contract test skips
# its cross-door checks (cookie login vs. API key, proving both land in the
# same place) — which is the single most important property in this system.
# Fill them in rather than ignoring the skip.
TEST_EMAIL=
TEST_PASSWORD=
